<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvItemTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título de la Incidencia"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#212121" />

    <TextView
        android:id="@+id/tvItemCategoriaFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoría: Vialidad | 19/10/2026 10:00:00"
        android:textSize="13sp"
        android:textStyle="italic"
        android:textColor="#1565C0"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvItemDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción detallada de la incidencia..."
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvItemCoordenadas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GPS: Lat -36.8201, Lng -73.0444"
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginTop="6dp" />

</LinearLayout>
