<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulario de Nueva Incidencia"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Campo 1: Titulo de la incidencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título de la incidencia *"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Bache profundo en calzada"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp" />

        <!-- Campo 2: Descripcion detallada -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción *"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describa el problema observado en terreno..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:gravity="top|start"
            android:layout_marginBottom="12dp" />

        <!-- Campo 3: Categoria (Spinner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría *"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Campo 4: Fecha y Hora (Autocompletada y bloqueada para edicion manual) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha y Hora de Registro (Automática)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFechaHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:focusable="false"
            android:textColor="#424242"
            android:layout_marginBottom="16dp" />

        <!-- Campo 5 y 6: Coordenadas Latitud y Longitud (Bloqueadas para edicion manual) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coordenadas GPS *"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etLatitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Latitud"
                android:enabled="false"
                android:focusable="false"
                android:textColor="#424242"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etLongitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Longitud"
                android:enabled="false"
                android:focusable="false"
                android:textColor="#424242" />
        </LinearLayout>

        <!-- Boton para obtener coordenadas del GPS -->
        <Button
            android:id="@+id/btnObtenerGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obtener Ubicación GPS"
            android:layout_marginBottom="20dp" />

        <!-- Boton para validar y guardar la incidencia -->
        <Button
            android:id="@+id/btnGuardarIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Incidencia"
            android:backgroundTint="#2E7D32"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>
